{
  "formulas": [
    {
      "name": "精选实验",
      "expr": "mean(best(2,field(\"实验1\"),field(\"实验2\"),field(\"实验3\")))"
    },
    {
      "name": "封顶平时",
      "expr": "min(100,field(\"精选实验\")+10)"
    },
    {
      "name": "总评",
      "expr": "field(\"封顶平时\")*0.4+field(\"作业\")*0.6"
    },
    {
      "name": "绩点",
      "expr": "ifelse(field(\"总评\")>=90,4,ifelse(field(\"总评\")>=80,3,0))"
    }
  ],
  "precision": 1,
  "summary_field": "总评",
  "excellent_threshold": "90",
  "excellent_denominator": "all"
}