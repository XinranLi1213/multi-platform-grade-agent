{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "运行成绩整合示例",
      "type": "process",
      "command": "python",
      "args": [
        "-X", "utf8", "grade_agent.py",
        "--platform-a", "inputs/platform_a.csv",
        "--platform-b", "inputs/platform_b.csv",
        "--rules", "inputs/rules.json",
        "--output-dir", "runs/baseline"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "运行全部验收",
      "type": "process",
      "command": "python",
      "args": ["-X", "utf8", "run_acceptance.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
