{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "启动本机教师页面",
      "type": "process",
      "command": "python",
      "args": [
        "-B",
        "-u",
        "-X",
        "utf8",
        "tools/launch.py"
      ],
      "problemMatcher": []
    },
    {
      "label": "开发：核对案例",
      "type": "process",
      "command": "python",
      "args": [
        "-B",
        "-X",
        "utf8",
        "${workspaceFolder}/../multi-platform-grade-agent-support/dev.py",
        "verify-data"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "开发：全部验收",
      "type": "process",
      "command": "python",
      "args": [
        "-B",
        "-X",
        "utf8",
        "${workspaceFolder}/../multi-platform-grade-agent-support/dev.py",
        "test",
        "all"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "开发：生成新数据",
      "type": "process",
      "command": "python",
      "args": [
        "-B",
        "-X",
        "utf8",
        "${workspaceFolder}/../multi-platform-grade-agent-support/dev.py",
        "generate",
        "two-stage"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "开发：独立浏览器服务",
      "type": "process",
      "command": "python",
      "args": [
        "-B",
        "-X",
        "utf8",
        "${workspaceFolder}/../multi-platform-grade-agent-support/dev.py",
        "serve-browser"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "处理已有CSV",
      "type": "process",
      "command": "python",
      "args": [
        "-B",
        "-X",
        "utf8",
        "grade_agent.py",
        "--platform-a",
        "${input:platformA}",
        "--platform-b",
        "${input:platformB}",
        "--rules",
        "${input:rulesFile}",
        "--output-dir",
        "${input:outputDirectory}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "platformA",
      "type": "promptString",
      "description": "已有平台A CSV路径（绝对路径或相对项目目录的路径）"
    },
    {
      "id": "platformB",
      "type": "promptString",
      "description": "已有平台B CSV路径（绝对路径或相对项目目录的路径）"
    },
    {
      "id": "rulesFile",
      "type": "promptString",
      "description": "已明确适用的规则JSON路径"
    },
    {
      "id": "outputDirectory",
      "type": "promptString",
      "description": "汇总结果的输出目录"
    }
  ]
}
